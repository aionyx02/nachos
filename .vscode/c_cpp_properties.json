{
    "configurations": [
        {
            "name": "NachOS userprog",
            "includePath": [
                "${workspaceFolder}/code/bin",
                "${workspaceFolder}/code/filesys",
                "${workspaceFolder}/code/userprog",
                "${workspaceFolder}/code/threads",
                "${workspaceFolder}/code/machine",
                "${workspaceFolder}/code/lib"
            ],
            "defines": [
                "THREADS",
                "USER_PROGRAM",
                "FILESYS_NEEDED",
                "FILESYS_STUB",
                "x86",
                "LINUX",
                "BSD"
            ],
            "forcedInclude": [
                "/usr/include/x86_64-linux-gnu/c++/11/bits/stdc++.h"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c89",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
